      "Bash(fly scale *)",
      "Bash(flyctl scale *)",
      "Bash(fly releases *)",
      "Bash(flyctl releases *)",
      "Bash(neonctl *)",
      "Bash(npx neonctl *)",
      "Bash(drizzle-kit migrate *)",
      "Bash(drizzle-kit push *)",
      "Bash(pnpm drizzle-kit *)",
      "Bash(npx drizzle-kit *)",
      "Bash(pnpm db:migrate *)",
      "Bash(eas build *)",
      "Bash(eas submit *)",
