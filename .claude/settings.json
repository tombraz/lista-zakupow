      "Bash(pnpm exec eslint *)",
      "Bash(pnpm --filter @lista/web build*)",
      "Bash(pnpm --filter @lista/api build*)",
      "Bash(pnpm --filter @lista/api db:generate*)",
      "Bash(pnpm audit *)",
      "Bash(bash scripts/test/*)"
