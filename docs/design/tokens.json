{
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "#ffffff", "$description": "tło ekranu, wiersze pozycji, karty" },
      "subtle": { "$value": "#f1f5f9", "$description": "nagłówek sekcji „Kupione”, pole linku zaproszenia" },
      "overlay": { "$value": "rgba(15, 23, 42, 0.5)", "$description": "przyciemnienie pod arkuszem i oknem dialogowym" }
    },
    "surface": {
      "brand": { "$value": "#0b4fbf", "$description": "pasek nagłówka i pasek dodawania pozycji" },
      "brand-control": { "$value": "#2a64c7", "$description": "przyciski-ikony na pasku marki" },
      "inverse": { "$value": "#0f172a", "$description": "pasek „brak połączenia”, komunikat chwilowy" }
    },
    "text": {
      "primary": { "$value": "#0f172a" },
      "secondary": { "$value": "#475569", "$description": "ilość/notatka, kto dodał, opisy" },
      "muted": { "$value": "#64748b", "$description": "nazwa odhaczonej pozycji (z przekreśleniem)" },
      "on-brand": { "$value": "#ffffff" },
      "on-accent": { "$value": "#0f172a" },
      "on-inverse": { "$value": "#ffffff" },
      "on-person": { "$value": "#ffffff", "$description": "inicjały w awatarze" }
    },
    "action": {
      "primary": { "$value": "#0b4fbf", "$description": "przyciski główne, checkbox, linki" },
      "primary-hover": { "$value": "#093f99" },
      "accent": { "$value": "#ffd23f", "$description": "przycisk „Dodaj” na pasku marki" },
      "accent-hover": { "$value": "#f5c400" },
      "danger": { "$value": "#b91c1c", "$description": "usuń, opuść, unieważnij" },
      "disabled": { "$value": "#cbd5e1" }
    },
    "status": {
      "done": { "$value": "#15803d", "$description": "wypełnienie odhaczonego checkboxa" },
      "warning-bg": { "$value": "#fff4cc" },
      "warning-text": { "$value": "#5c4300" },
      "error-bg": { "$value": "#fde8e8" },
      "error-text": { "$value": "#8a1414" },
      "success-bg": { "$value": "#dcfce7" },
      "success-text": { "$value": "#14532d" }
    },
    "border": {
      "default": { "$value": "#e2e8f0", "$description": "linie między wierszami (dekoracyjne)" },
      "input": { "$value": "#64748b", "$description": "obramowanie pól tekstowych i checkboxów zgód" }
    },
    "focus": {
      "ring": { "$value": "#0b4fbf" },
      "ring-on-brand": { "$value": "#ffd23f" }
    },
    "person": {
      "1": { "$value": "#0b4fbf" },
      "2": { "$value": "#b4235a" },
      "3": { "$value": "#0f766e" },
      "4": { "$value": "#6d28d9" },
      "5": { "$value": "#b45309" },
      "6": { "$value": "#475569" }
    }
  },
  "typography": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "title-lg": { "$value": "24px", "$description": "tytuł ekranów bez paska (logowanie, rejestracja)" },
      "title": { "$value": "20px", "$description": "tytuł w pasku nagłówka, nazwa karty listy" },
      "item": { "$value": "18px", "$description": "nazwa pozycji, pola tekstowe" },
      "body": { "$value": "16px" },
      "small": { "$value": "14px", "$description": "notatka, kto dodał, opisy pod polami" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "base": { "$value": 1.5 }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "2xl": { "$value": "32px" }
  },
  "size": {
    "$type": "dimension",
    "target-min": { "$value": "48px", "$description": "minimalny cel dotyku: przyciski, ikony, checkboxy" },
    "item-row": { "$value": "60px", "$description": "minimalna wysokość wiersza pozycji" },
    "checkbox": { "$value": "40px", "$description": "widoczny kwadrat; obszar dotyku = target-min" },
    "avatar": { "$value": "32px" },
    "content-max": { "$value": "560px", "$description": "maksymalna szerokość kolumny na komputerze" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "full": { "$value": "9999px" }
  },
  "elevation": {
    "$type": "shadow",
    "sheet": { "$value": { "color": "rgba(15, 23, 42, 0.25)", "offsetX": "0px", "offsetY": "-4px", "blur": "16px", "spread": "0px" } },
    "toast": { "$value": { "color": "rgba(15, 23, 42, 0.25)", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": "120ms", "$description": "zmiana stanu checkboxa, hover" },
    "normal": { "$value": "200ms", "$description": "wysunięcie arkusza, przeniesienie pozycji do „Kupione”" }
  },
  "focus": {
    "width": { "$type": "dimension", "$value": "3px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  }
}
