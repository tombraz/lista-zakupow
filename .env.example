# Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.
# Lokalna baza z docker-compose.yml: postgres://lista:lista@localhost:5442/lista
DATABASE_URL=
# Co najmniej 32 losowe znaki, np. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Adres, pod którym przeglądarka otwiera aplikację; lokalnie Vite: http://localhost:5173
APP_ORIGIN=
PORT=
# Adresy / CIDR proxy przed API, po przecinku; lokalnie puste.
TRUSTED_PROXIES=
HOST=
LOG_LEVEL=
