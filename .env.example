# Skopiuj do .env i uzupełnij. Nigdy nie commituj .env.
# Lokalna baza z docker-compose.yml: postgres://lista:lista@localhost:5442/lista
DATABASE_URL=
# Co najmniej 32 losowe znaki, np. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Adres, pod którym przeglądarka otwiera aplikację; lokalnie Vite: http://localhost:5173
APP_ORIGIN=
# Dostawca maila resetu hasła; lokalnie Mailpit z docker-compose.yml (podgląd: ten sam adres).
MAILPIT_URL=http://localhost:8025
# Na serwerze: MAILER=brevo oraz BREVO_API_KEY, MAIL_FROM (zweryfikowany nadawca) i ALERT_EMAIL
# w sekretach Fly.
MAILER=
BREVO_API_KEY=
MAIL_FROM=
# Adres alarmów do właściciela projektu (np. linki resetu nieunieważnione, T-088). Wymagany przy
# MAILER=brevo; lokalnie opcjonalny (puste = alarm tylko w logu, podany = mail w Mailpicie).
ALERT_EMAIL=
PORT=
# Adresy / CIDR proxy przed API, po przecinku; lokalnie puste.
TRUSTED_PROXIES=
HOST=
LOG_LEVEL=
